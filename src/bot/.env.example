# ── Required ──────────────────────────────────────────────
# Twitch channel login to read chat from (no leading #)
CHANNEL=your_twitch_login

# Session trigger: command | redeem | both
#   command = a mod/broadcaster types !kawkaw
#   redeem  = a Channel Points redemption (needs EventSub creds below)
TRIGGER=command

# ── Engine tuning (optional) ──────────────────────────────
# Leave commented out to use the defaults in src/overlay/js/meter.js — the bot
# prints the config it resolved on startup. Uncomment only what you want to change.
#STEP=0.5
#DECAY=0.05
#MAX_SESSION_DURATION=300
#PER_USER_CAP=5

# HTTP/WS port — serves the OBS-via-bot WebSocket and the EventSub webhook
PORT=3000

# ── Twitch Extension broadcast (PubSub) — only if shipping the Extension ──
# Numeric broadcaster user id (PubSub is keyed by id, not login).
# Not needed for OBS-only. The redeem trigger fills this in automatically.
TWITCH_CHANNEL_ID=
TWITCH_CLIENT_ID=
# Base64 shared secret from the Twitch Developer Console
TWITCH_EXTENSION_SECRET=
# Twitch user id of the extension owner (signs PubSub JWTs)
TWITCH_EXTENSION_OWNER_ID=

# ── Redeem trigger (EventSub) — only if TRIGGER includes redeem ──
EVENTSUB_SECRET=
