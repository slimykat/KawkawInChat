PORT=3000

# Twitch EventSub webhook secret (set when registering the subscription)
EVENTSUB_SECRET=your_eventsub_webhook_secret

# Twitch Extension credentials (from Developer Console)
TWITCH_CLIENT_ID=your_client_id
# Base64-encoded shared secret (from Developer Console) used to verify viewer vote JWTs
TWITCH_EXTENSION_SECRET=your_extension_secret_base64
# Twitch user id of the extension owner — used to sign PubSub JWTs sent to the Helix endpoint
TWITCH_EXTENSION_OWNER_ID=your_extension_owner_user_id
