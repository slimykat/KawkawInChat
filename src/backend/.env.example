# Set once at install. Everything tunable lives in the config page instead —
# open http://127.0.0.1:3000/ once the backend is running.

# ── Required ──────────────────────────────────────────────
# Twitch channel login to read chat from (no leading #)
CHANNEL=your_twitch_login

# Loopback port for the overlay, config page, and state stream.
# The backend binds 127.0.0.1 only — it is never reachable from the network.
PORT=3000

# ── Channel Points redeem trigger only ────────────────────
# Leave blank unless you want redemptions to summon KawKaw. The chat-command
# trigger needs none of this — it reads chat anonymously.
#
# Register an application at https://dev.twitch.tv/console/apps and set its
# OAuth Redirect URL to exactly:   http://localhost:3000/auth/callback
# (match the port above if you changed it)
#
# On first run with the redeem trigger enabled, the backend prints a link.
# Open it once to authorize; the token is stored in tokens.json and refreshed
# automatically from then on.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
