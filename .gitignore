# Secrets — never commit real credentials (Twitch app client id/secret, OAuth tokens)
.env
.env.*
!.env.example
tokens.json

# Per-streamer settings written by the config page
config.json
config.json.tmp

# Game assets — not redistributable. The sprite sheet and voice clips are
